{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "@unif/react-native-design-example#test": {
      "inputs": [
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/yarn.lock",
        "$TURBO_ROOT$/.yarnrc.yml",
        "$TURBO_ROOT$/.nvmrc",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/tsconfig.build.json",
        "$TURBO_ROOT$/babel.config.js",
        "$TURBO_ROOT$/react-native.config.js",
        "$TURBO_ROOT$/jest-setup.js",
        "$TURBO_ROOT$/jest-preset.js",
        "$TURBO_ROOT$/jest-resolver.js",
        "$TURBO_ROOT$/src/**",
        "$TURBO_ROOT$/example/package.json",
        "$TURBO_ROOT$/example/app.json",
        "$TURBO_ROOT$/example/index.js",
        "$TURBO_ROOT$/example/babel.config.js",
        "$TURBO_ROOT$/example/metro.config.js",
        "$TURBO_ROOT$/example/jest.config.js",
        "$TURBO_ROOT$/example/jest.showcaseGate.js",
        "$TURBO_ROOT$/example/jest.setup.ts",
        "$TURBO_ROOT$/example/jest.forbidOnlyReporter.js",
        "$TURBO_ROOT$/example/tsconfig.json",
        "$TURBO_ROOT$/example/.eslintrc.js",
        "$TURBO_ROOT$/example/src/**",
        "$TURBO_ROOT$/scripts/run-example-jest.mjs",
        "$TURBO_ROOT$/scripts/verify-example-showcase.mjs"
      ],
      "outputs": []
    },
    "@unif/react-native-design-example#build:android": {
      "env": ["ANDROID_HOME", "ORG_GRADLE_PROJECT_newArchEnabled"],
      "inputs": [
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/yarn.lock",
        "$TURBO_ROOT$/.yarnrc.yml",
        "$TURBO_ROOT$/.nvmrc",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/tsconfig.build.json",
        "$TURBO_ROOT$/babel.config.js",
        "$TURBO_ROOT$/react-native.config.js",
        "$TURBO_ROOT$/src/**",
        "!$TURBO_ROOT$/src/__tests__/**",
        "!$TURBO_ROOT$/src/**/__tests__/**",
        "!$TURBO_ROOT$/src/*.test.*",
        "!$TURBO_ROOT$/src/**/*.test.*",
        "$TURBO_ROOT$/example/package.json",
        "$TURBO_ROOT$/example/app.json",
        "$TURBO_ROOT$/example/index.js",
        "$TURBO_ROOT$/example/babel.config.js",
        "$TURBO_ROOT$/example/metro.config.js",
        "$TURBO_ROOT$/example/tsconfig.json",
        "$TURBO_ROOT$/example/src/**",
        "!$TURBO_ROOT$/example/src/__tests__/**",
        "!$TURBO_ROOT$/example/src/**/__tests__/**",
        "!$TURBO_ROOT$/example/src/*.test.*",
        "!$TURBO_ROOT$/example/src/**/*.test.*",
        "$TURBO_ROOT$/example/android/**",
        "!$TURBO_ROOT$/example/android/.gradle/**",
        "!$TURBO_ROOT$/example/android/**/.cxx/**",
        "!$TURBO_ROOT$/example/android/**/build/**",
        "!$TURBO_ROOT$/example/android/local.properties"
      ],
      "outputs": []
    },
    "@unif/react-native-design-example#build:ios": {
      "env": [
        "RCT_NEW_ARCH_ENABLED",
        "RCT_REMOVE_LEGACY_ARCH",
        "RCT_USE_RN_DEP",
        "RCT_USE_PREBUILT_RNCORE"
      ],
      "inputs": [
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/yarn.lock",
        "$TURBO_ROOT$/.yarnrc.yml",
        "$TURBO_ROOT$/.nvmrc",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/tsconfig.build.json",
        "$TURBO_ROOT$/babel.config.js",
        "$TURBO_ROOT$/react-native.config.js",
        "$TURBO_ROOT$/src/**",
        "!$TURBO_ROOT$/src/__tests__/**",
        "!$TURBO_ROOT$/src/**/__tests__/**",
        "!$TURBO_ROOT$/src/*.test.*",
        "!$TURBO_ROOT$/src/**/*.test.*",
        "$TURBO_ROOT$/example/package.json",
        "$TURBO_ROOT$/example/app.json",
        "$TURBO_ROOT$/example/index.js",
        "$TURBO_ROOT$/example/babel.config.js",
        "$TURBO_ROOT$/example/metro.config.js",
        "$TURBO_ROOT$/example/tsconfig.json",
        "$TURBO_ROOT$/example/src/**",
        "!$TURBO_ROOT$/example/src/__tests__/**",
        "!$TURBO_ROOT$/example/src/**/__tests__/**",
        "!$TURBO_ROOT$/example/src/*.test.*",
        "!$TURBO_ROOT$/example/src/**/*.test.*",
        "$TURBO_ROOT$/example/Gemfile",
        "$TURBO_ROOT$/example/Gemfile.lock",
        "$TURBO_ROOT$/example/ios/**",
        "!$TURBO_ROOT$/example/ios/Pods/**",
        "!$TURBO_ROOT$/example/ios/**/build/**",
        "!$TURBO_ROOT$/example/ios/**/DerivedData/**",
        "!$TURBO_ROOT$/example/ios/.xcode.env.local"
      ],
      "outputs": []
    }
  }
}
